{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"features": {
		"ghcr.io/devcontainers-extra/features/poetry:2": {
			"version": "1.8.5"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"GitHub.copilot",
				"github.vscode-github-actions"
			]
		}
	}
}
